# ============================================================
# MECHPRO backend environment — copy to .env and fill in.
#   cp .env.example .env
# ============================================================

# --- Core ---
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Where the React frontend lives (used for CORS + sitemap URLs)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
# Development default is SQLite (leave DATABASE_URL empty).
# Production example: DATABASE_URL=postgres://mechpro:password@localhost:5432/mechpro
DATABASE_URL=

# --- Email (Gmail app password on the dedicated MECHPRO Google account) ---
# Create at: Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=mechpro.co.ke@gmail.com
EMAIL_HOST_PASSWORD=paste-16-char-app-password-here
DEFAULT_FROM_EMAIL=MECHPRO SOLUTIONS LTD <mechpro.co.ke@gmail.com>

# Where new-lead alerts are delivered (comma-separated; sales team inboxes)
RFQ_NOTIFY_EMAILS=mechpro.co.ke@gmail.com

# --- Google reCAPTCHA (v2 checkbox or v3) — leave empty to disable in dev ---
RECAPTCHA_SECRET_KEY=
